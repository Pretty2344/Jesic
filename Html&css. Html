<title>WebLearn — Belajar Web Development</title>

<style>
/* =====================================================
   RESET
===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Inter, Arial, sans-serif;
    background: #080b14;
    color: #f5f7ff;
    line-height: 1.6;
    transition: background .3s, color .3s;
}

a {
    text-decoration: none;
    color: inherit;
}

button,
input {
    font: inherit;
}

/* =====================================================
   VARIABLES
===================================================== */

:root {
    --primary: #6c63ff;
    --secondary: #00d4ff;
    --pink: #ff4ecd;

    --bg: #080b14;
    --sidebar: #0d111d;
    --card: #111625;
    --card-hover: #171d30;

    --text: #f5f7ff;
    --muted: #929bb4;

    --border: rgba(255,255,255,.08);

    --shadow:
        0 20px 60px rgba(0,0,0,.25);

    --radius: 22px;
}

/* LIGHT MODE */

body.light {
    --bg: #f5f7fb;
    --sidebar: #ffffff;
    --card: #ffffff;
    --card-hover: #f0f2f8;

    --text: #101322;
    --muted: #687083;

    --border: rgba(0,0,0,.08);

    --shadow:
        0 20px 50px rgba(30,40,80,.10);
}

/* =====================================================
   LAYOUT
===================================================== */

.app {
    display: flex;
    min-height: 100vh;
}

/* =====================================================
   SIDEBAR
===================================================== */

.sidebar {
    width: 270px;
    height: 100vh;

    position: fixed;
    left: 0;
    top: 0;

    background: var(--sidebar);
    border-right: 1px solid var(--border);

    padding: 25px 18px;

    z-index: 1000;

    transition: .35s ease;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;

    font-size: 22px;
    font-weight: 800;

    padding: 10px 12px;
    margin-bottom: 35px;
}

.logo-icon {
    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--secondary)
        );

    color: white;
}

.logo span {
    color: var(--secondary);
}

.sidebar-title {
    font-size: 11px;
    color: var(--muted);

    text-transform: uppercase;
    letter-spacing: 1.5px;

    margin: 20px 12px 10px;
}

.menu-list {
    list-style: none;
}

.menu-list li {
    margin: 5px 0;
}

.menu-list a {
    display: flex;
    align-items: center;
    gap: 13px;

    padding: 12px 14px;

    border-radius: 12px;

    color: var(--muted);

    font-size: 14px;

    transition: .25s;
}

.menu-list a:hover,
.menu-list a.active {
    background: rgba(108,99,255,.13);
    color: var(--text);
}

.menu-list a.active {
    box-shadow: inset 3px 0 var(--primary);
}

.menu-icon {
    font-size: 18px;
}

/* SIDEBAR BOTTOM */

.sidebar-bottom {
    position: absolute;
    bottom: 25px;
    left: 18px;
    right: 18px;
}

.progress-box {
    padding: 17px;

    background: var(--card);

    border: 1px solid var(--border);

    border-radius: 16px;
}

.progress-box small {
    color: var(--muted);
}

.progress-bar {
    height: 6px;

    margin: 10px 0;

    background: rgba(128,128,128,.2);

    border-radius: 20px;

    overflow: hidden;
}

.progress-fill {
    width: 68%;
    height: 100%;

    background:
        linear-gradient(
            90deg,
            var(--primary),
            var(--secondary)
        );

    border-radius: inherit;
}

/* =====================================================
   MAIN
===================================================== */

.main {
    margin-left: 270px;
    width: calc(100% - 270px);
}

/* =====================================================
   TOPBAR
===================================================== */

.topbar {
    height: 70px;

    position: sticky;
    top: 0;

    z-index: 900;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 35px;

    background: rgba(8,11,20,.75);

    backdrop-filter: blur(15px);

    border-bottom: 1px solid var(--border);
}

body.light .topbar {
    background: rgba(245,247,251,.8);
}

.search {
    width: 300px;

    position: relative;
}

.search input {
    width: 100%;

    padding: 10px 15px 10px 40px;

    border-radius: 12px;

    border: 1px solid var(--border);

    outline: none;

    background: var(--card);

    color: var(--text);
}

.search-icon {
    position: absolute;
    left: 14px;
    top: 9px;
}

.top-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.icon-btn {
    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    border: 1px solid var(--border);

    background: var(--card);

    color: var(--text);

    border-radius: 12px;

    cursor: pointer;

    transition: .25s;
}

.icon-btn:hover {
    transform: translateY(-2px);
}

/* =====================================================
   CONTENT
===================================================== */

.content {
    width: min(1150px, 90%);
    margin: auto;
}

/* =====================================================
   HERO
===================================================== */

.hero {
    min-height: 620px;

    display: flex;
    align-items: center;

    position: relative;

    overflow: hidden;
}

.hero::before {
    content: "";

    position: absolute;

    width: 500px;
    height: 500px;

    background: var(--primary);

    filter: blur(160px);

    opacity: .2;

    left: -150px;
    top: 50px;
}

.hero::after {
    content: "";

    position: absolute;

    width: 400px;
    height: 400px;

    background: var(--secondary);

    filter: blur(160px);

    opacity: .12;

    right: -100px;
    bottom: -100px;
}

.hero-content {
    position: relative;
    z-index: 2;

    max-width: 750px;
}

.badge {
    display: inline-flex;

    padding: 8px 14px;

    border-radius: 50px;

    background: rgba(108,99,255,.1);

    border: 1px solid var(--border);

    color: #aeb2ff;

    font-size: 13px;

    margin-bottom: 25px;
}

.hero h1 {
    font-size: clamp(45px, 7vw, 80px);

    line-height: 1.02;

    letter-spacing: -4px;

    margin-bottom: 25px;
}

.gradient {
    background:
        linear-gradient(
            90deg,
            var(--secondary),
            var(--primary),
            var(--pink)
        );

    -webkit-background-clip: text;

    color: transparent;
}

.hero p {
    max-width: 650px;

    color: var(--muted);

    font-size: 18px;

    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 13px 22px;

    border-radius: 13px;

    font-weight: 700;

    border: 1px solid var(--border);

    transition: .3s;
}

.btn:hover {
    transform: translateY(-3px);
}

.btn-primary {
    color: white;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            #5148e8
        );
}

.btn-secondary {
    background: var(--card);
}

/* =====================================================
   SECTION
===================================================== */

section {
    padding: 90px 0;
}

.section-heading {
    margin-bottom: 45px;
    max-width: 650px;
}

.section-heading span {
    color: var(--secondary);

    font-size: 12px;

    text-transform: uppercase;

    letter-spacing: 2px;

    font-weight: 700;
}

.section-heading h2 {
    font-size: 42px;

    line-height: 1.15;

    margin: 10px 0;
}

.section-heading p {
    color: var(--muted);
}

/* =====================================================
   MATERIAL CARDS
===================================================== */

.material-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;
}

.material-card {
    position: relative;

    padding: 28px;

    background: var(--card);

    border: 1px solid var(--border);

    border-radius: var(--radius);

    overflow: hidden;

    transition: .35s;

    cursor: pointer;
}

.material-card::before {
    content: "";

    position: absolute;

    width: 130px;
    height: 130px;

    right: -60px;
    top: -60px;

    background: var(--primary);

    filter: blur(50px);

    opacity: .15;
}

.material-card:hover {
    transform: translateY(-8px);

    background: var(--card-hover);

    border-color: rgba(108,99,255,.45);

    box-shadow: var(--shadow);
}

.material-icon {
    width: 55px;
    height: 55px;

    display: grid;
    place-items: center;

    border-radius: 15px;

    font-size: 25px;

    margin-bottom: 20px;

    background: rgba(108,99,255,.12);
}

.material-card h3 {
    font-size: 21px;

    margin-bottom: 8px;
}

.material-card p {
    color: var(--muted);

    font-size: 14px;

    margin-bottom: 18px;
}

.material-meta {
    display: flex;

    justify-content: space-between;

    color: var(--muted);

    font-size: 12px;
}

/* =====================================================
   CODE SECTION
===================================================== */

.code-section {
    background: rgba(128,128,128,.03);
}

.code-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 30px;

    align-items: center;
}

.code-text h2 {
    font-size: 42px;

    margin-bottom: 18px;
}

.code-text p {
    color: var(--muted);

    margin-bottom: 20px;
}

.code-box {
    background: #05070d;

    border-radius: 18px;

    overflow: hidden;

    border: 1px solid var(--border);

    box-shadow: var(--shadow);
}

.code-header {
    display: flex;

    align-items: center;

    gap: 7px;

    padding: 13px 17px;

    border-bottom: 1px solid rgba(255,255,255,.08);

    color: #858da4;

    font-size: 12px;
}

.dot {
    width: 9px;
    height: 9px;

    border-radius: 50%;

    background: #555;
}

pre {
    padding: 25px;

    overflow-x: auto;

    color: #dce1ff;

    font-family: Consolas, monospace;

    font-size: 13px;
}

.tag {
    color: #ff79c6;
}

.attr {
    color: #8be9fd;
}

.value {
    color: #a6e3a1;
}

/* =====================================================
   BLOG
===================================================== */

.blog-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 22px;
}

.blog-card {
    overflow: hidden;

    background: var(--card);

    border: 1px solid var(--border);

    border-radius: 20px;

    transition: .3s;
}

.blog-card:hover {
    transform: translateY(-7px);

    box-shadow: var(--shadow);
}

.blog-image {
    height: 190px;

    display: grid;

    place-items: center;

    font-size: 52px;

    background:
        linear-gradient(
            135deg,
            rgba(108,99,255,.3),
            rgba(0,212,255,.08)
        );
}

.blog-content {
    padding: 24px;
}

.blog-category {
    color: var(--secondary);

    font-size: 12px;

    font-weight: 700;
}

.blog-content h3 {
    margin: 8px 0;

    font-size: 20px;
}

.blog-content p {
    color: var(--muted);

    font-size: 14px;
}

.read-more {
    display: inline-block;

    margin-top: 18px;

    color: #aeb5ff;

    font-size: 13px;

    font-weight: 700;
}

/* =====================================================
   FEATURE BOX
===================================================== */

.feature {
    padding: 70px 30px;

    text-align: center;

    border-radius: 28px;

    border: 1px solid var(--border);

    background:
        radial-gradient(
            circle at top,
            rgba(108,99,255,.25),
            transparent 60%
        ),
        var(--card);
}

.feature h2 {
    font-size: 42px;

    margin-bottom: 15px;
}

.feature p {
    max-width: 600px;

    margin: auto auto 25px;

    color: var(--muted);
}

/* =====================================================
   FOOTER
===================================================== */

footer {
    padding: 35px 0;

    border-top: 1px solid var(--border);
}

.footer-content {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;
}

.footer-content p {
    color: var(--muted);

    font-size: 13px;
}

.footer-links {
    display: flex;

    gap: 20px;

    color: var(--muted);

    font-size: 13px;
}

/* =====================================================
   SCROLL ANIMATION
===================================================== */

.reveal {
    opacity: 0;

    transform: translateY(40px);

    transition:
        opacity .8s ease,
        transform .8s ease;
}

.reveal.show {
    opacity: 1;

    transform: translateY(0);
}

/* =====================================================
   MOBILE SIDEBAR
===================================================== */

.sidebar-toggle {
    display: none;
}

/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width: 1000px) {

    .sidebar {
        transform: translateX(-100%);
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .main {
        margin-left: 0;

        width: 100%;
    }

    .sidebar-toggle {
        display: grid;
    }

    .material-grid,
    .blog-grid {
        grid-template-columns: 1fr 1fr;
    }

    .code-grid {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 650px) {

    .topbar {
        padding: 0 15px;
    }

    .search {
        width: 150px;
    }

    .content {
        width: 90%;
    }

    section {
        padding: 65px 0;
    }

    .hero {
        min-height: 580px;
    }

    .hero h1 {
        font-size: 46px;

        letter-spacing: -2px;
    }

    .hero p {
        font-size: 16px;
    }

    .section-heading h2,
    .code-text h2,
    .feature h2 {
        font-size: 33px;
    }

    .material-grid,
    .blog-grid {
        grid-template-columns: 1fr;
    }

    .footer-content {
        flex-direction: column;

        text-align: center;
    }
}

@media(max-width: 430px) {

    .search {
        display: none;
    }

    .hero h1 {
        font-size: 40px;
    }

    .btn {
        width: 100%;
    }
}
</style>
</head>


